<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F5FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- App title and search icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="My Bucket List ✨"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#37316B" />

            <ImageButton
                android:id="@+id/btnSearchIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_search"
                android:contentDescription="Search bucket list"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#6558C8" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dream it. Plan it. Do it."
            android:textSize="14sp"
            android:textColor="#777777"
            android:paddingBottom="12dp" />

        <!-- Search area hidden initially -->
        <LinearLayout
            android:id="@+id/layoutSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search bucket list..."
                android:singleLine="true"
                android:inputType="text"
                android:padding="10dp" />

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Search"
                android:textAllCaps="false"
                android:backgroundTint="#6558C8" />
        </LinearLayout>

        <!-- Add or edit a bucket-list item -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add a Bucket List Item"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#37316B"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bucket list item"
            android:inputType="textCapSentences"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Target date (DD/MM/YYYY)"
            android:inputType="text"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add to Bucket List"
            android:textAllCaps="false"
            android:layout_marginTop="8dp"
            android:backgroundTint="#6558C8" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear Form"
            android:textAllCaps="false" />

        <!-- Pending section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏳ Pending Bucket List"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#37316B"
            android:paddingTop="22dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutPending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Completed section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Completed Bucket List"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#237447"
            android:paddingTop="24dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutCompleted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep dreaming and ticking things off!"
            android:gravity="center"
            android:textColor="#777777"
            android:paddingTop="24dp"
            android:paddingBottom="16dp" />

    </LinearLayout>
</ScrollView>
